# ⚠️ ESTE É SÓ O MODELO. O site NÃO lê este arquivo!

# Nome da loja (aparece no site e na mensagem do WhatsApp)
LOJA_NOME=DOCEFEFE.21

# WhatsApp da sua mãe, com código do país e DDD, SÓ NÚMEROS.
# Ex.: (11) 98765-4321  ->  5511987654321
WHATSAPP_NUMERO=5511987654321

# Perfil do Instagram. O site mostra o @ e o botão leva para cá.
INSTAGRAM_URL=https://www.instagram.com/docefefe.21

# Senha para acessar o site interno de administração. Troque por uma senha forte.
ADMIN_SENHA=troque-esta-senha

# Chave usada para assinar o cookie de login. Gere uma aleatória:
SECRET_KEY=troque-esta-chave-por-uma-aleatoria

# Antecedência mínima para encomendas (em dias). 1 = só a partir de amanhã.
ANTECEDENCIA_DIAS=1

# Ex.: postgresql://postgres.abcdef:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
